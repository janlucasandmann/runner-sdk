  /app/repos/runner-web-sdk/apps/platform/server/execution-dispatch/project-delivery-task.mjs
COPY repos/runner-web-sdk/src/platform-services/configure-mode/tests/server/runtime.mjs \
  /app/repos/runner-web-sdk/src/platform-services/configure-mode/tests/server/runtime.mjs
COPY repos/runner-web-sdk/src/platform-services/configure-mode/evaluations/server/runtime.mjs \
  /app/repos/runner-web-sdk/src/platform-services/configure-mode/evaluations/server/runtime.mjs
COPY repos/runner-web-sdk/src/platform-services/configure-mode/evaluations/server/domain/sets.mjs \
  /app/repos/runner-web-sdk/src/platform-services/configure-mode/evaluations/server/domain/sets.mjs
