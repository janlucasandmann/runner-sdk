{
  "name": "@computer-agents/runner-web-sdk",
  "version": "0.1.0",
  "description": "Standalone runner integration for building AI agent web apps with streaming logs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/styles.css": {
      "default": "./dist/react/runner-chat.css"
    },
    "./platform-ui/data-table": {
      "types": "./dist/platform-ui/data-table/index.d.ts",
      "default": "./dist/platform-ui/data-table/index.js"
    },
    "./platform-ui/data-table/styles.css": {
      "default": "./dist/platform-ui/data-table/data-table.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run platform-table-invariants && node ./scripts/runner-chat-assets.mjs prepare && tsc -p tsconfig.json && node ./scripts/runner-chat-assets.mjs copy",
    "clean": "rm -rf dist",
    "history-smoke": "npm run build && node ./examples/history-api-test.mjs",
    "metronome-runtime-test": "node ./examples/metronome-dynamic-content-runtime-test.mjs",
    "thread-domain-test": "npm run build && node ./examples/thread-domain-test.mjs",
    "thread-ui-test": "npm run build && node ./examples/thread-ui-test.mjs",
    "thread-proxy-test": "node ./examples/demo-thread-v2-proxy-test.mjs",
    "thread-preview": "npm run build && node ./examples/thread-ui-preview.mjs",
    "realtime-metronome-test": "npm run build && node ./examples/realtime-metronome-adapters-test.mjs",
    "platform-table-invariants": "node ./scripts/platform-table-invariants.mjs",
    "platform-table-test": "npm run platform-table-invariants && vitest run src/platform-ui/data-table",
    "smoke": "npm run build && node ./examples/smoke-test.mjs",
    "demo": "npm run build && node ./examples/demo-server.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@git-diff-view/file": "^0.1.3",
    "@git-diff-view/react": "^0.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-table": "^8.21.3",
    "chart.js": "^4.5.1",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.3.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "novnc-next": "^1.0.0",
    "pdfjs-dist": "^5.4.624",
    "pptx-preview": "^1.0.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.0.0",
    "ws": "^8.20.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.17"
  }
}
