# Local platform host
PORT=4177
PLATFORM_API_PORT=4177
PLATFORM_VITE_PORT=5173
PLATFORM_APP_ORIGIN=http://localhost:4177
PLATFORM_VITE_ORIGIN=http://127.0.0.1:5173
AIOS_APP_ORIGIN=http://localhost:3001
RUNNER_UPSTREAM_ORIGIN=https://api.computer-agents.com/v1

# Deployment placement and browser identity. Hosted deployments retain the
# Firebase adapter by default. Enterprise appliances use the OIDC BFF settings
# below and point RUNNER_UPSTREAM_ORIGIN at their local control API.
DEPLOYMENT_TOPOLOGY=gcp_saas
IDENTITY_PROVIDER=firebase
# IDENTITY_PROVIDER=oidc
# OIDC_ISSUER_URL=https://identity.enterprise.example/realms/computer-agents
# OIDC_CLIENT_ID=computer-agents-platform
# OIDC_CLIENT_SECRET=
# OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
# OIDC_SCOPES=openid,profile,email
# OIDC_AUDIENCE=computer-agents-platform
# OIDC_ALLOWED_ID_TOKEN_ALGORITHMS=RS256,PS256,ES256,EdDSA
# PLATFORM_SESSION_SECRET=
# PLATFORM_CONTROL_PLANE_SECRET=
# CONNECTOR_MCP_ORIGIN=https://platform.example.com
# CONNECTOR_RUNTIME_SIGNING_KEY=
# PLATFORM_PRINCIPAL_ASSERTION_ISSUER=computer-agents-platform
# PLATFORM_PRINCIPAL_ASSERTION_AUDIENCE=computer-agents-control-api
# PLATFORM_SESSION_TTL_SECONDS=28800
# PLATFORM_COOKIE_SECURE=true

# Optional paths when this repository is not inside the historical monorepo
# AIOS_HOSTING_ROOT=/absolute/path/to/web/hosting
# COMPUTER_AGENTS_CLOUD_INFRASTRUCTURE_ROOT=/absolute/path/to/cloud-infrastructure
# PLATFORM_SYSTEM_SKILLS_ROOT=/absolute/path/to/skills
# PLATFORM_RUNTIME_ENV_FILES=/absolute/path/to/.env.local:/absolute/path/to/.env

# Restricted operational pages (empty means deny all users)
# PLATFORM_ADMIN_EMAIL=operator@example.com
# ADMIN_API_KEY=
# CONTACT_SALES_API_TOKEN=
# FEEDBACK_SUMMARY_DISABLE_VM_FALLBACK=1
# PRODUCT_USAGE_SUMMARY_DISABLE_VM_FALLBACK=1

# Firebase identity lookup
# FIREBASE_REST_API_KEY=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Connector OAuth
# CONNECTOR_OAUTH_ALLOWED_ORIGINS=https://platform.example.com,http://localhost:4177
# CONNECTOR_TOKEN_ENCRYPTION_KEY=

# GitHub OAuth
# GITHUB_OAUTH_ALLOWED_ORIGINS=https://platform.example.com,http://localhost:4177
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:4177/api/github/callback
# GITHUB_TOKEN_ENCRYPTION_KEY=

# Atlassian OAuth 2.0 (3LO) for Jira and Confluence
# ATLASSIAN_OAUTH_CLIENT_ID=
# ATLASSIAN_OAUTH_CLIENT_SECRET=
# ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:4177/api/jira/callback
# JIRA_OAUTH_CLIENT_ID=             # supported compatibility alias
# JIRA_OAUTH_CLIENT_SECRET=         # supported compatibility alias
# JIRA_OAUTH_REDIRECT_URI=          # supported compatibility alias
# JIRA_TOKEN_ENCRYPTION_KEY=

# Dropbox OAuth 2.0
# DROPBOX_OAUTH_CLIENT_ID=          # Dropbox App key
# DROPBOX_OAUTH_CLIENT_SECRET=      # Dropbox App secret
# DROPBOX_OAUTH_CALLBACK_URL=http://localhost:4177/api/aios/connectors/dropbox/callback
# DROPBOX_TOKEN_ENCRYPTION_KEY=     # optional; falls back to CONNECTOR_TOKEN_ENCRYPTION_KEY

# Asana OAuth 2.0
# ASANA_OAUTH_CLIENT_ID=
# ASANA_OAUTH_CLIENT_SECRET=
# ASANA_OAUTH_CALLBACK_URL=http://localhost:4177/api/aios/connectors/asana/callback
# ASANA_TOKEN_ENCRYPTION_KEY=       # optional; falls back to CONNECTOR_TOKEN_ENCRYPTION_KEY

# Box OAuth 2.0
# BOX_OAUTH_CLIENT_ID=
# BOX_OAUTH_CLIENT_SECRET=
# BOX_OAUTH_CALLBACK_URL=http://localhost:4177/api/aios/connectors/box/callback
# BOX_TOKEN_ENCRYPTION_KEY=         # optional; falls back to CONNECTOR_TOKEN_ENCRYPTION_KEY

# Figma OAuth 2.0
# FIGMA_OAUTH_CLIENT_ID=
# FIGMA_OAUTH_CLIENT_SECRET=
# FIGMA_OAUTH_CALLBACK_URL=http://localhost:4177/api/aios/connectors/figma/callback
# FIGMA_TOKEN_ENCRYPTION_KEY=       # optional; falls back to CONNECTOR_TOKEN_ENCRYPTION_KEY

# Linear OAuth 2.0
# LINEAR_OAUTH_CLIENT_ID=
# LINEAR_OAUTH_CLIENT_SECRET=
# LINEAR_OAUTH_CALLBACK_URL=http://localhost:4177/api/aios/connectors/linear/callback
# LINEAR_TOKEN_ENCRYPTION_KEY=      # optional; falls back to CONNECTOR_TOKEN_ENCRYPTION_KEY

# One Microsoft Entra app serves Teams, Outlook, and Outlook Calendar.
# MICROSOFT_CONNECTOR_CLIENT_ID=
# MICROSOFT_CONNECTOR_CLIENT_SECRET=
# MICROSOFT_TEAMS_OAUTH_CALLBACK_URL=http://localhost:4177/api/aios/connectors/microsoft-teams/callback
# OUTLOOK_OAUTH_CALLBACK_URL=http://localhost:4177/api/aios/connectors/outlook/callback
# OUTLOOK_CALENDAR_OAUTH_CALLBACK_URL=http://localhost:4177/api/aios/connectors/outlook-calendar/callback
# MICROSOFT_TEAMS_TOKEN_ENCRYPTION_KEY= # optional; falls back to CONNECTOR_TOKEN_ENCRYPTION_KEY
# OUTLOOK_TOKEN_ENCRYPTION_KEY=         # optional; falls back to CONNECTOR_TOKEN_ENCRYPTION_KEY
# OUTLOOK_CALENDAR_TOKEN_ENCRYPTION_KEY= # optional; falls back to CONNECTOR_TOKEN_ENCRYPTION_KEY

# Slack OAuth 2.0
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_CALLBACK_URL=http://localhost:4177/api/aios/connectors/slack/callback
# SLACK_TOKEN_ENCRYPTION_KEY=       # optional; falls back to CONNECTOR_TOKEN_ENCRYPTION_KEY

# BigQuery uses a service-account JSON credential entered in the connector UI.
# BIGQUERY_TOKEN_ENCRYPTION_KEY=    # optional; falls back to CONNECTOR_TOKEN_ENCRYPTION_KEY

# Notion OAuth
# NOTION_OAUTH_REDIRECT_URI=https://example.com/api/notion/callback

# Optional deployment-VM fallback for restricted operational summaries
# GOOGLE_CLOUD_PROJECT=
# GCLOUD_BIN=/absolute/path/to/gcloud
# TESTBASE_DEPLOYMENT_VM_PROJECT=
# TESTBASE_DEPLOYMENT_VM_NAME=
# TESTBASE_DEPLOYMENT_VM_NAME_PREFIX=testbase-mig-
